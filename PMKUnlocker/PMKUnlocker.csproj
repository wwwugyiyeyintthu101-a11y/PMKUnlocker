<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- PotatoNV library တွေ (x86) နဲ့ libusb-1.0.dll (32-bit) အတွက် x86 ဖြစ်ရမယ် -->
    <PlatformTarget>x86</PlatformTarget>
    <Version>7.3.5</Version>
    <FileVersion>7.3.5.0</FileVersion>
    <InformationalVersion>7.3.5</InformationalVersion>
    <Product>PMK Mobile Tool</Product>
    <AssemblyTitle>PMK Mobile Tool</AssemblyTitle>
    <ApplicationIcon>pmk.ico</ApplicationIcon>
    <!-- fh_loader / fastboot / mtk ops တွေ admin လိုလို့ tool ကိုယ်တိုင် admin -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Huawei/Honor Kirin bootloader unlock — PotatoNV-next ရဲ့ core library တွေ -->
  <ItemGroup>
    <Reference Include="Potato.ImageFlasher">
      <HintPath>libs\potato\Potato.ImageFlasher.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Potato.Fastboot">
      <HintPath>libs\potato\Potato.Fastboot.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LibUsbDotNet.LibUsbDotNet">
      <HintPath>libs\potato\LibUsbDotNet.LibUsbDotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- libusb-1.0.dll (32-bit) ကို exe ဘေးကို copy — Potato.Fastboot က P/Invoke နဲ့ ခေါ်တယ် -->
  <ItemGroup>
    <None Update="libs\potato\libusb-1.0.dll">
      <TargetPath>libusb-1.0.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- MTK helper — erase/seccfg ပြီးရင် ဖုန်းကို Android ထဲ တကယ် auto-reboot ပေးတဲ့ script
       (mtkclient CLI ရဲ့ `reset` က power off သာ လုပ်လို့) — exe ဘေးမှာ ရှိရမယ် -->
  <ItemGroup>
    <Content Include="..\SHOP_SETUP.md" Link="SHOP_SETUP.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE_SERVER_SETUP.md" Link="LICENSE_SERVER_SETUP.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\REPAIR_NOTES_2026-10-11.md" Link="REPAIR_NOTES_2026-10-11.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="bundled-tools\**\*" />
    <Content Include="bundled-tools\**\*">
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="pmk_devices.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="pmk_qc_loaders.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="pmk_mtk_devices.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="pmk_codenames.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- phone-model DB (4,600+ models: brand → model → chip → ops) -->
    <None Update="pmk_models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- MTK Auth Bypass (in-tool) — MTK-bypass/bypass_utility (MIT) + exploits_collection payloads
       + UsbDk installer — '🔐 MTK Auth Bypass' ခလုတ်က ခေါ်တယ် (external MABT exe မသုံး) -->
  <ItemGroup>
    <None Remove="tools\mtkclient\**\*" />
    <None Remove="tools\mtkclient\**\__pycache__\**" />
    <Content Include="tools\mtkclient\**\*" Exclude="tools\mtkclient\**\__pycache__\**;tools\mtkclient\**\__pycache__\*.*">
      <TargetPath>tools\mtkclient\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- MTK native recipes (mtk\boot-profiles) are PMK's own DA/EMI artefacts: they are not tracked in git and not
       shipped. Without the folder the NATIVE tab is deliberately absent (BuildNativeDaTab returns early), so a
       clean/rebuild of bin used to look like a different program. Keep the master copy in the tool's data
       directory and copy it into every build output; override with -p:MtkRecipeSource=<folder> if it lives
       somewhere else. -->
  <PropertyGroup>
    <MtkRecipeSource Condition="'$(MtkRecipeSource)' == ''">$(UserProfile)\AppData\Local\PMKMobileTool\mtk\boot-profiles</MtkRecipeSource>
  </PropertyGroup>
  <Target Name="CopyMtkBootRecipes" BeforeTargets="Build" Condition="Exists('$(MtkRecipeSource)')">
    <ItemGroup>
      <_MtkRecipeFile Include="$(MtkRecipeSource)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MtkRecipeFile)"
          DestinationFiles="@(_MtkRecipeFile->'$(OutDir)mtk\boot-profiles\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- SkipToolIntegrity is the CI opt-out: a checkout without the untracked tool inventory cannot write the
       manifest. Release/publish builds and every local build keep the default (fail closed). -->
  <Target Name="WriteBuildIntegrity" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipToolIntegrity)' != 'true'">
    <PropertyGroup><IntegrityReleaseArguments Condition="'$(Configuration)' == 'Release'">-VerifyBundled</IntegrityReleaseArguments></PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)\..\scripts\write_runtime_integrity.ps1&quot; -SourceRoot &quot;$(MSBuildProjectDirectory)&quot; -OutputRoot &quot;$(TargetDir).&quot; $(IntegrityReleaseArguments)" />
  </Target>
  <Target Name="WritePublishIntegrity" AfterTargets="Publish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)\..\scripts\write_runtime_integrity.ps1&quot; -SourceRoot &quot;$(MSBuildProjectDirectory)&quot; -OutputRoot &quot;$(PublishDir).&quot; -VerifyBundled" />
  </Target>
</Project>
